# Copy to .env and fill in. Never commit .env.
# API key from the Console org linked to the class Team plan (pooled monthly API credits) — used from Milestone 3
# Create at https://platform.claude.com/settings/keys. Keep it here only; never export it in your shell.
ANTHROPIC_API_KEY=
# Needed when the key's scope is Organization: Console → Settings → Workspaces → ID column (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Jev expert (TypeSafe) — used from Milestone 3; the TypeSafe SDK reads this name
TYPESAFE_API_KEY=
# Snowflake (trial/class account only) — optional; when all six are set, agent/warehouse.py copies
# silver and gold tables after each import. SNOWFLAKE_PASSWORD can be a programmatic access token.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
